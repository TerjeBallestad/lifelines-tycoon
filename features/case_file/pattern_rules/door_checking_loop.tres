[ext_resource type="Script" path="res://features/case_file/case_entry.gd" id="2"]

[sub_resource type="Resource" id="trace"]
script = ExtResource("2")
id = &"trace_security_steady"
source = 0
provenance = &"authored"
title = "Doors and locks kept under steady watch"
body = "Through the whole week the flat stays sealed and re-checked — locks tried, the door confirmed, the same rounds repeated so that the sense of being shut in never slips. Nothing in the log loosens it."
tags = []
require_state = {}

[resource]
script = ExtResource("1")
