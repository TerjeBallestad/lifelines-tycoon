[sub_resource type="Resource" id="trace"]
script = ExtResource("2")
id = &"trace_no_company"
source = 0
provenance = &"authored"
title = "Whole days pass without company"
body = "Across the logged week there is no small talk, no walk out, no caller received — the days run their course start to finish inside the flat with no one else in them."
